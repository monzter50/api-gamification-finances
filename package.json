{
  "name": "api-gamification-finances",
  "version": "1.0.1",
  "description": "API para aplicación de gamificación de finanzas",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx --env-file=.env src/server.ts",
    "dev:watch": "tsx --env-file=.env --watch src/server.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "docs": "echo 'OpenAPI docs: http://localhost:3000/api-docs'",
    "export:schema": "tsx src/scripts/exportOpenApi.ts",
    "generate:client": "yarn run tsx src/scripts/exportOpenApi.ts && yarn run openapi-typescript openapi-schema.json -o src/types/openapi.d.ts",
    "cleanup:screenshot-import": "tsx src/scripts/cleanupScreenshotImport.ts",
    "clean:macos": "dot_clean -m . 2>/dev/null || true",
    "compose:dev": "yarn clean:macos && COPYFILE_DISABLE=1 docker compose up",
    "compose:dev:tools": "yarn clean:macos && COPYFILE_DISABLE=1 docker compose --profile tools up",
    "compose:dev:down": "docker compose down",
    "compose:staging": "yarn clean:macos && COPYFILE_DISABLE=1 docker compose -f docker-compose.yml -f docker-compose.staging.yml --env-file .env.staging up -d",
    "compose:staging:down": "docker compose -f docker-compose.yml -f docker-compose.staging.yml --env-file .env.staging down",
    "compose:prod": "yarn clean:macos && COPYFILE_DISABLE=1 docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production up -d",
    "compose:prod:down": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production down",
    "compose:logs": "docker compose logs -f api"
  },
  "keywords": [
    "gamification",
    "finances",
    "api",
    "express",
    "node"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@aglaya/logger": "^0.1.0",
    "@prisma/client": "5",
    "bcryptjs": "^3.0.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^24.0.12",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "eslint": "^10.12.0",
    "neostandard": "^0.14.1",
    "openapi-typescript": "^7.13.0",
    "prisma": "5",
    "supertest": "^7.3.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "resolutions": {
    "fast-uri": "^3.1.8",
    "source-map-js": "^1.2.2",
    "uuid": "^11.1.1",
    "vite": "^7.3.7"
  }
}
