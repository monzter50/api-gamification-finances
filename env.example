# =============================================================================
# Local development template — copy to `.env` and fill in real values.
# This file IS committed; `.env` is NOT.
# =============================================================================

# ---- Server ----
NODE_ENV=development
PORT=3000

# ---- PostgreSQL (used by docker-compose to spin up the DB container) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gamification_finances_dev
POSTGRES_PORT=5432

# ---- Database connection (used by Prisma at runtime) ----
# Running the API directly on the host (`yarn dev`):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gamification_finances_dev?schema=public

# Running the API inside docker-compose: the compose file overrides
# DATABASE_URL to use the in-network host `postgres` automatically.

# ---- JWT ----
# REQUIRED — the server refuses to start without it. Use a long random value:
#   openssl rand -base64 48
JWT_SECRET=change-me-locally-to-a-long-random-value
JWT_EXPIRES_IN=7d

# ---- API ----
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Stricter budget for /auth/login and /auth/register (failed attempts only)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ---- Request bodies ----
# JSON body limit for normal endpoints, and for the bulk import confirm endpoint
JSON_BODY_LIMIT=100kb
IMPORT_JSON_BODY_LIMIT=10mb

# ---- API docs ----
# Swagger UI, /api-docs.json and /api/docs. Default: on outside production,
# off in production. Set explicitly to override.
# ENABLE_API_DOCS=true

# ---- Logging ----
LOG_LEVEL=debug

# ---- Reverse proxy ----
# Number of proxy hops in front of this app. 0 = no proxy (default).
# Set to 1 when deployed behind Railway / Render / Heroku / Nginx.
# Set to 2 if you add Cloudflare in front of those.
# NEVER set Express `trust proxy: true` — clients can then spoof their IP.
TRUST_PROXY_HOPS=0

# ---- Google Sheets export (optional) ----
# Leave GOOGLE_CLIENT_ID empty to disable the feature. When it is set, ALL of
# the variables below are required or the server refuses to start.
# Google Cloud: enable Sheets API + Drive API, OAuth consent screen with the
# `.../auth/drive.file` scope, OAuth client of type "Web application" whose
# authorized redirect URI is exactly GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Where the browser returns after connecting (lands on /settings/integrations)
FRONTEND_URL=http://localhost:5173
# Encrypts stored Google refresh tokens (AES-256-GCM). 32 random bytes, base64:
#   openssl rand -base64 32
# Rotating it invalidates stored tokens (users must reconnect Google).
TOKEN_ENCRYPTION_KEY=
# Max syncs per user per minute
GOOGLE_SYNC_RATE_LIMIT_MAX=6

# ---- Image tag (used when pulling/pushing built images) ----
IMAGE_TAG=latest
